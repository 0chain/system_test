# 0Chain Deployment Secrets Template
# Copy this file to .secrets.env and fill in the values.
# .secrets.env is gitignored and should NEVER be committed.

# GitHub Personal Access Token (required for cloning private repos: 0box, web-apps, zauth-server, zvault, crawler)
# Generate at: https://github.com/settings/tokens (classic token with 'repo' scope for 0chain org)
GITHUB_TOKEN=

# ============================================================
# Web App Environment (Firebase, Auth0, API keys)
# ============================================================

# Firebase Configuration (project: box-dev-ce8bf)
# These have defaults in the deploy script — only override if using a different project
FBASE_API_KEY=<firebase-api-key>
FBASE_AUTH_DOMAIN=box-dev-ce8bf.firebaseapp.com
FBASE_DB_URL=https://box-dev-ce8bf.firebaseio.com
FBASE_PROJECT_ID=box-dev-ce8bf
FBASE_STORAGE_BUCKET=box-dev-ce8bf.appspot.com
FBASE_MESSAGING_SENDER_ID=893964718514
FBASE_APP_ID=1:893964718514:web:6d6f2ee9f96211e64954ab
FBASE_SHARE_LINK=https://zuspublicdev.page.link

# Auth0 Configuration
AUTH0_SECRET=
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# External API Keys
ALCHEMY_API_KEY=
RECAPTCHA_KEY=
